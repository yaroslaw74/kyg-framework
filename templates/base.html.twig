<!DOCTYPE html>
<html lang="{{ locale_HTML(app.locale) }}" dir="{{ locale_dir(app.locale) }}" data-nav-layout="vertical" data-bs-theme="light" data-theme-mode="light" data-header-styles="light" data-menu-styles="light" data-toggled="close">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
        <meta name="robots" content="noindex, nofollow">
        <meta name="autor" content="Kataev Yaroslav">
        <meta name="Description" content="KYG Framework for Business">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="HandheldFriendly" content="True">
        <meta name="MobileOptimized" content="320">

        <title>{% block title %}{% if app_name %}{{ app_name }}|{% endif %}KYG Framevork{% endblock %}</title>

        {{ pwa(locale: app.locale) }}

        {% block stylesheets %}{% endblock %}

        {% block importmap %}
            {{ importmap([locale_dir(app.locale), 'icons', 'plugins', 'valex', 'app']) }}
        {% endblock importmap %}

        {% block javascripts %}{% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
            <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
            <script src="{{ asset('vendor/idiomorph/dist/idiomorph.min.js') }}"></script>
            <script src="{{ asset('vendor/frankenphp-hot-reload/frankenphp-hot-reload.index.js') }}" type="module"></script>
        {% endif %}

        {{ nelmio_js_error_logger() }}
    </head>
    <body {{ stimulus_controller('swup', {
            theme: 'fade',
            debug: app.debug,
        }) }}>
        {% block body %}{% endblock %}
    </body>
</html>
