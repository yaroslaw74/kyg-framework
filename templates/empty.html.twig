{% extends 'base.html.twig' %}

{% block stylesheets %}
    <!-- Flatpickr Css -->
    <link rel="stylesheet" href="{{ asset('libs/flatpickr/flatpickr.min.css') }}">
{% endblock %}

{% block javascripts %}
    <!-- Main Theme Js -->
    <script src="{{ asset('js/modules/main.js') }}" type="module" async></script>
{% endblock %}

{% block body %}

    {{ include('partials/switcher.html.twig') }}
    {{ include('partials/loader.html.twig') }}

    <div class="page">
        {{ include('partials/header.html.twig') }}
        {{ include('partials/sidebar.html.twig') }}

        <!-- Start::app-content -->
        <main class="main-content app-content transition-fade" id="swup">
            <div class="container-fluid">
                {% block main_header %}
                    {{ include('partials/page-header.html.twig', {title: 'Empty', subtitle: 'Pages'}) }}
                {% endblock main_header %}

                {% block main_content %}{% endblock %}

            </div>
        </main>
        <!-- End::app-content -->

        {{ include('partials/footer.html.twig') }}

    </div>

    {{ include('partials/commonjs.html.twig') }}

    <!-- Defaultmenu JS -->
    <script src="{{ asset('js/modules/defaultmenu.js') }}" type="module" async></script>

    <!-- Sticky JS -->
    <script src="{{ asset('js/modules/sticky.js') }}" type="module" async></script>

    <!-- Simplebar JS -->
    <script src="{{ asset('js/modules/simplebar.js') }}" type="module" async></script>

    <!-- Custom-Switcher JS -->
    <script src="{{ asset('js/modules/custom-switcher.js') }}" type="module" async></script>

    {% block body_javascript %}{% endblock %}

    <!-- Custom JS -->
    <script src="{{ asset('js/modules/custom.js') }}" type="module" async></script>

     <!-- Card JS -->
    <script src="{{ asset('js/card.js') }}"></script> {##}

    <!-- Count-up JS -->
    <script src="{{ asset('js/count-up.js') }}"></script> {##}

    <!-- Toggle Switches JS -->
    <script src="{{ asset('js/toggle-switches.js') }}"></script> {##}
{% endblock body %}
