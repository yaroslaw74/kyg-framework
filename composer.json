    "replace": {
        "symfony/polyfill-apcu": "*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-icu": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Additions\\": "public/additions/",
            "App\\Modules\\": "modules/"
        },
        "classmap": [
            "config/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        },
        "classmap": [
            "src/Kernel.php"
        ],
        "files": [
            "vendor/rector/rector/preload.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "liborm85/composer-vendor-cleaner": true,
            "neronmoon/scriptsdev": true,
            "pantheon-se/node-composer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "rector/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": true
        },
        "apcu-autoloader": true,
        "bump-after-update": true,
        "dev-files": {
            "no-dev-only": true
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "process-timeout": 3000,
        "sort-packages": true
    },
    "extra": {
        "dev-files": {
            "*/*": [
                ".git/",
                ".github/",
                ".phive/",
                "docs/",
                "test/",
                "tests/",
                "*.md",
                "CHANGELOG",
                "CREDITS",
                "LICENCE",
                "LICENSE",
                "LICENSE.*",
                "NOTICE",
                "README",
                "README.*",
                "Makefile",
                ".deepsource.toml",
                ".gitattributes",
                ".editorconfig",
                ".gitignore",
                ".gitmodules",
                ".phpstorm.meta.php",
                ".php_cs.php",
                ".php_cs.dist",
                ".php-cs-fixer.php",
                ".php-cs-fixer.dist.php",
                ".prettierrc",
                ".roave-backward-compatibility-check.xml",
                ".travis.yml",
                ".valgrindrc",
                "biome.json",
                "composer.json",
                "composer.lock",
                "composer-require-check.json",
                "phpbench.json",
                "phpcs.xml",
                "phpdoc.dist.xml",
                "phpstan.dist.neon",
                "phpstan.neon",
                "phpstan.neon.dist",
                "phpunit.xml",
                "phpunit.dist.xml",
                "phpunit.xml.dist",
                "phpunit-deprecation-baseline.xml",
                "phpunit-rector.xml.dist",
                "phpunit11.dist.xml",
                "phpstan-baseline.neon",
                "psalm.xml",
                "psalm-baseline.xml"
            ]
        },
        "mkdir": {
            "etc/build": "0644",
            "features": "0644",
            "migrations": "0644",
            "public/additions": "0777",
            "public/media/images": "0777",
            "public/translations": "0777"
        },
        "pantheon-se": {
            "node-composer": {
                "node-version": true,
                "yarn-version": false
            }
        },
        "scripts-dev": {
            "post-install-cmd": [
                "@php bin/console biomejs:download"
            ],
            "post-update-cmd": [
                "@npm-format",
                "@php bin/console lint:twig templates/ public/additions/ modules/ --show-deprecations",
                "vendor/bin/twig-cs-fixer fix",
                "bin/biome lint --write assets modules public/additions",
                "bin/biome check --write assets modules public/additions",
                "bin/biome format --write assets modules public/additions",
                "vendor/bin/phpstan analyse --error-format friendly",
                "vendor/bin/php-cs-fixer fix",
                "@php bin/console doctrine:diagram:er"
            ],
            "npm-format": "npm run format"
        },
        "symfony": {
            "allow-contrib": true,
            "endpoint": [
                "https://api.github.com/repos/Sylius/SyliusRecipes/contents/index.json?ref=flex/main",
                "flex://defaults"
            ],
            "require": "^7.4|^8.0"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "Balrok\\ComposerMkdir\\ScriptHandler::mkdirs",
            "@build",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@build",
            "@auto-scripts"
        ],
        "post-create-project-cmd": [
            "@php bin/console sylius:inform-about-gus --ansi",
            "@php bin/console sylius:show-plus-info --ansi"
        ],
        "auto-scripts": {
            "requirements-checker": "script",
            "cache:clear": "symfony-cmd",
            "cache:warmup": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd"
        },
        "build": [
            "npm install",
            "npm run build"
        ],
        "rector-apply": "vendor/bin/rector process",
        "rector-dry-run": "vendor/bin/rector process --dry-run"
    }
}
