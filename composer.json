{
    "name": "yaroslaw74/kyg-framework",
    "description": "KYG Framework for Business",
    "license": [
        "GPL-3.0-or-later",
        "MIT"
    ],
    "type": "project",
    "authors": [
        {
            "name": "Kataev Yaroslav",
            "email": "yaroslaw74@gmail.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "yaroslaw74@gmail.com",
        "issues": "https://github.com/yaroslaw74/kyg-framework/issues",
        "forum": "https://github.com/yaroslaw74/kyg-framework/discussions",
        "wiki": "https://github.com/yaroslaw74/kyg-framework/wiki",
        "source": "https://github.com/yaroslaw74/kyg-framework",
        "security": "https://github.com/yaroslaw74/kyg-framework/security"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "doctrine/doctrine-bundle": "^2.18.2",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6.6",
        "hwi/oauth-bundle": "^2.5",
        "jbtronics/settings-bundle": "^3.3.1",
        "knplabs/knp-menu-bundle": "^3.7",
        "knplabs/knp-paginator-bundle": "^6.10",
        "league/flysystem-bundle": "^3.7",
        "php-http/httplug-bundle": "^2.3",
        "phpdocumentor/reflection-docblock": "^6.0.3",
        "phpstan/phpdoc-parser": "^2.3.2",
        "pyrrah/gravatar-bundle": "^1.5.2",
        "rekalogika/file-association": "^1.14",
        "rekalogika/file-bundle": "^1.14",
        "rekalogika/file-filepond": "^1.8",
        "rekalogika/file-symfony-bridge": "^1.14",
        "rekalogika/file-zip": "^1.14",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/asset": "^7.4.8",
        "symfony/asset-mapper": "^7.4.11",
        "symfony/console": "^7.4.11",
        "symfony/doctrine-messenger": "^7.4.6",
        "symfony/dotenv": "^7.4.11",
        "symfony/expression-language": "^7.4.8",
        "symfony/flex": "^2.10",
        "symfony/form": "^7.4.9",
        "symfony/framework-bundle": "^7.4.11",
        "symfony/http-client": "^7.4.9",
        "symfony/intl": "^7.4.8",
        "symfony/mailer": "^7.4.12",
        "symfony/mime": "^7.4.12",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/notifier": "^7.4.8",
        "symfony/process": "^7.4.11",
        "symfony/property-access": "^7.4.8",
        "symfony/property-info": "^7.4.8",
        "symfony/runtime": "^7.4.12",
        "symfony/security-bundle": "^7.4.12",
        "symfony/serializer": "^7.4.10",
        "symfony/stimulus-bundle": "^2.35",
        "symfony/string": "^7.4.11",
        "symfony/translation": "^7.4.10",
        "symfony/twig-bundle": "^7.4.8",
        "symfony/ux-autocomplete": "^3.0",
        "symfony/ux-chartjs": "^3.0",
        "symfony/ux-cropperjs": "^3.0",
        "symfony/ux-dropzone": "^3.0",
        "symfony/ux-google-map": "^3.0",
        "symfony/ux-icons": "^3.0",
        "symfony/ux-live-component": "^3.0",
        "symfony/ux-map": "^3.0",
        "symfony/ux-turbo": "^3.0",
        "symfony/ux-twig-component": "^3.0",
        "symfony/validator": "^7.4.10",
        "symfony/web-link": "^7.4.8",
        "symfony/yaml": "^7.4.12",
        "twig/cache-extra": "^3.24",
        "twig/cssinliner-extra": "^3.26",
        "twig/extra-bundle": "^3.24",
        "twig/html-extra": "^3.24",
        "twig/inky-extra": "^3.26",
        "twig/markdown-extra": "^3.26",
        "twig/string-extra": "^3.24",
        "twig/twig": "^3.26",
        "yokai/enum-bundle": "^5.1",
        "yokai/security-token-bundle": "^3.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "apcu-autoloader": true,
        "optimize-autoloader": true,
        "process-timeout": 3000
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-icu": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "cache:warmup": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "importmap:update": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "^7.4"
        }
    },
    "require-dev": {
        "php-http/guzzle7-adapter": "*",
        "phpunit/phpunit": "^13.1.12",
        "symfony/browser-kit": "^7.4.8",
        "symfony/css-selector": "^7.4.9",
        "symfony/debug-bundle": "^7.4.8",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "^7.4.8",
        "symfony/web-profiler-bundle": "^7.4.12"
    }
}
