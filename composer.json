    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-icu": "*",
        "symfony/polyfill-intl-idn": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Additions\\": "public/additions/",
            "App\\Modules\\": "modules/"
        },
        "classmap": [
            "config/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "liborm85/composer-vendor-cleaner": true,
            "neronmoon/scriptsdev": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "symfony/thanks": true
        },
        "apcu-autoloader": true,
        "bump-after-update": true,
        "dev-files": {
            "no-dev-only": true
        },
        "optimize-autoloader": true,
        "process-timeout": 3000,
        "sort-packages": true
    },
    "extra": {
        "copy-file": {
            "modules/Install/Resources/data/theme/": "public/theme/"
        },
        "dev-files": {
            "*/*": [
                ".git/",
                ".github/",
                ".phive/",
                "docs/",
                "test/",
                "tests/",
                "*.md",
                "CHANGELOG",
                "CREDITS",
                "LICENCE",
                "LICENSE",
                "LICENSE.*",
                "NOTICE",
                "README",
                "README.*",
                "Makefile",
                ".deepsource.toml",
                ".gitattributes",
                ".editorconfig",
                ".gitignore",
                ".gitmodules",
                ".phpstorm.*",
                ".php_cs.*",
                ".php-cs-fixer.*",
                ".prettierrc",
                ".roave-backward-compatibility-check.xml",
                ".travis.yml",
                ".valgrindrc",
                "behat.*",
                "biome.*",
                "composer.*",
                "composer-require-check.json",
                "phpbench.json",
                "phpcs.xml",
                "phpdoc.dist.xml",
                "phpstan.*",
                "phpunit.*",
                "phpunit-deprecation-baseline.xml",
                "phpunit-rector.xml.dist",
                "phpstan-baseline.neon",
                "psalm.*",
                "psalm-baseline.*",
                "rector.*"
            ]
        },
        "mkdir": {
            "migrations": "0644",
            "public/additions": "0777",
            "public/storage": "0777",
            "public/storage/Documents": "0777",
            "public/storage/Downloads": "0777",
            "public/storage/Images": "0777",
            "public/storage/Music": "0777",
            "public/storage/Other": "0777",
            "public/storage/Videos": "0777",
            "public/translations": "0777",
            "public/uploads": "0777"
        },
        "scripts-dev": {
            "post-install-cmd": [
                "@php bin/console biomejs:download",
                "vendor/bin/bdi detect drivers"
            ],
            "post-update-cmd": [
                "@php bin/console lint:twig templates/ public/additions/ modules/ --show-deprecations",
                "vendor/bin/twig-cs-fixer fix",
                "bin/biome lint --write assets",
                "bin/biome check --write assets",
                "bin/biome format --write assets",
                "vendor/bin/rector process --dry-run",
                "vendor/bin/psalm --alter --issues=all --dry-run",
                "vendor/bin/phpstan analyse",
                "vendor/bin/php-cs-fixer fix"
            ]
        },
        "symfony": {
            "allow-contrib": true,
            "require": "8.2.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "Balrok\\ComposerMkdir\\ScriptHandler::mkdirs",
            "SlowProg\\CopyFile\\ScriptHandler::copy",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "requirements-checker": "script",
            "cache:clear": "symfony-cmd",
            "cache:warmup": "symfony-cmd",
            "ckeditor:install --clear=drop --release=full": "symfony-cmd",
            "assets:install --symlink --relative %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "sass:build": "symfony-cmd",
            "asset-map:compile": "symfony-cmd"
        }
    }
}
