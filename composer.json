    "require-dev": {
        "composer/composer": "^2.10",
        "dadadev/phpstan-symfony-routing": "^0.3",
        "dama/doctrine-test-bundle": "^8.6",
        "dbrekelmans/bdi": "^1.4",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "ergebnis/composer-normalize": "^2.52",
        "friendsofphp/php-cs-fixer": "^3.95",
        "jawira/doctrine-diagram-bundle": "^1.2",
        "kocal/biome-js-bundle": "^2.1",
        "kocal/phpstan-symfony-ux": "^1.3",
        "martinkup/symfony-profiler-optimization-advisor-bundle": "^0.1",
        "matthiasnoback/symfony-config-test": "^6.2",
        "matthiasnoback/symfony-dependency-injection-test": "^6.3",
        "neronmoon/scriptsdev": "^0.1",
        "nowo-tech/twig-inspector-bundle": "^1.0.",
        "orklah/psalm-insane-comparison": "^2.4",
        "orklah/psalm-strict-equality": "^3.1",
        "patchlevel/event-sourcing-psalm-plugin": "^3.2",
        "php-http/guzzle7-adapter": "^1.1",
        "php-standard-library/psalm-plugin": "^2.4",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/php-code-coverage": "^14.2",
        "phpunit/php-file-iterator": "^7.0",
        "phpunit/php-invoker": "^7.0",
        "phpunit/php-text-template": "^6.0",
        "phpunit/php-timer": "^9.0",
        "phpunit/phpunit": "^13.1",
        "psalm/plugin-phpunit": "^0.19",
        "psalm/plugin-symfony": "^5.3",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "symfony/browser-kit": "^8.1",
        "symfony/debug-bundle": "^8.1",
        "symfony/dom-crawler": "^8.1",
        "symfony/maker-bundle": "^1.67",
        "symfony/panther": "^2.4",
        "symfony/thanks": "^1.4",
        "symfony/web-profiler-bundle": "^8.1",
        "symplify/config-transformer": "^12.5",
        "symplify/phpstan-rules": "^14.11",
        "systemsdk/easy-log-bundle": "^2.1",
        "vimeo/psalm": "^6.16 || ^7.0",
        "vincentlanglet/twig-cs-fixer": "^3.14",
        "weirdan/doctrine-psalm-plugin": "^2.10",
        "yamadashy/phpstan-friendly-formatter": "^1.4",
        "zenstruck/browser": "^1.10",
        "zenstruck/foundry": "^2.10",
        "zenstruck/mailer-test": "^1.5",
        "zenstruck/messenger-test": "^1.14"
