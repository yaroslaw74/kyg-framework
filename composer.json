        "kocal/phpstan-symfony-ux": "^1.3",
        "lctrs/psalm-psr-container-plugin": "^1.11",
        "marartner/psalm-strict-equality": "^3.0",
        "martinkup/symfony-profiler-optimization-advisor-bundle": "^0.1.1",
        "neronmoon/scriptsdev": "^0.1.9",
