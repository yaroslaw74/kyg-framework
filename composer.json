        "symplify/phpstan-extensions": "*",
        "symplify/phpstan-rules": "*",
        "systemsdk/easy-log-bundle": "*",
        "vimeo/psalm": "^6.16.1 || ^7.0.0",
        "vincentlanglet/twig-cs-fixer": "*",
