{
    "controllers": {
        "@rekalogika/file-filepond": {
            "filepond": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": []
            }
        },
        "@rekalogika/temporary-url-bundle": {
            "autoexpire": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": []
            }
        },
        "@symfony/ux-cropperjs": {
            "cropper": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "cropperjs/dist/cropper.min.css": true,
                    "@symfony/ux-cropperjs/dist/style.min.css": true
                }
            }
        },
        "@symfony/ux-turbo": {
            "turbo-core": {
                "enabled": true,
                "fetch": "eager"
            },
            "mercure-turbo-stream": {
                "enabled": false,
                "fetch": "eager"
            }
        }
    },
    "entrypoints": []
}
