                "fetch": "eager"
            },
            "backgroundsync-queue": {
                "enabled": false,
                "fetch": "eager"
            },
            "badge": {
                "enabled": false,
                "fetch": "eager"
            },
            "barcode-detection": {
                "enabled": false,
                "fetch": "eager"
            },
            "battery": {
                "enabled": false,
                "fetch": "eager"
            },
            "connection-status": {
                "enabled": false,
                "fetch": "eager"
            },
            "contact": {
                "enabled": false,
                "fetch": "eager"
            },
            "device-motion": {
                "enabled": false,
                "fetch": "eager"
            },
            "device-orientation": {
                "enabled": false,
                "fetch": "eager"
            },
            "file-handling": {
                "enabled": false,
                "fetch": "eager"
            },
            "fullscreen": {
                "enabled": false,
                "fetch": "eager"
            },
            "geolocation": {
                "enabled": false,
                "fetch": "eager"
            },
            "install": {
                "enabled": false,
                "fetch": "eager"
            },
            "network-information": {
                "enabled": false,
                "fetch": "eager"
            },
            "prefetch-on-demand": {
                "enabled": false,
                "fetch": "eager"
            },
            "picture-in-picture": {
                "enabled": false,
                "fetch": "eager"
            },
            "presentation": {
                "enabled": false,
                "fetch": "eager"
            },
            "receiver": {
                "enabled": false,
                "fetch": "eager"
            },
            "capture": {
                "enabled": false,
                "fetch": "eager"
            },
            "service-worker": {
                "enabled": false,
                "fetch": "eager"
            },
            "speech-synthesis": {
                "enabled": false,
                "fetch": "eager"
            },
            "touch": {
                "enabled": false,
                "fetch": "eager"
            },
            "vibration": {
                "enabled": false,
                "fetch": "eager"
            },
            "wake-lock": {
                "enabled": false,
                "fetch": "eager"
            },
            "web-push": {
                "enabled": false,
                "fetch": "eager"
            },
            "web-share": {
                "enabled": false,
                "fetch": "eager"
            }
        },
        "@symfony/ux-autocomplete": {
            "autocomplete": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "tom-select/dist/css/tom-select.default.css": false,
                    "tom-select/dist/css/tom-select.bootstrap4.css": false,
                    "tom-select/dist/css/tom-select.bootstrap5.css": true
                }
            }
        },
        "@symfony/ux-chartjs": {
            "chart": {
                "enabled": true,
                "fetch": "eager"
            }
        },
        "@symfony/ux-cropperjs": {
            "cropper": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "cropperjs/dist/cropper.min.css": true,
                    "@symfony/ux-cropperjs/dist/style.min.css": true
                }
            }
        },
        "@symfony/ux-dropzone": {
            "dropzone": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@symfony/ux-dropzone/dist/style.min.css": true
                }
            }
        },
        "@symfony/ux-google-map": {
            "map": {
                "enabled": true,
                "fetch": "lazy"
            }
        },
        "@symfony/ux-live-component": {
            "live": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@symfony/ux-live-component/dist/live.min.css": true
                }
            }
        },
        "@symfony/ux-turbo": {
            "turbo-core": {
                "enabled": true,
                "fetch": "eager",
                "autoimport": {
                    "@symfony/ux-turbo/dist/mercure_stream_source_element.js": true
                }
            },
            "mercure-turbo-stream": {
                "enabled": false,
                "fetch": "eager"
            }
        }
    },
    "entrypoints": []
