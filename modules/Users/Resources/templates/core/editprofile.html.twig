{% extends '@Core/empty.html.twig' %}

{% trans_default_domain 'users' %}

{% form_theme setAvatarUserForm 'bootstrap_5_layout.html.twig' %}

{% form_theme profileForm 'bootstrap_5_layout.html.twig' %}

{% if user %}
    {% set pageUser = user %}
{% else %}
    {% set pageUser = app.user %}
{% endif %}

{% block main_header %}
    {{ include('@Core/partials/page-header.html.twig', {title: 'Edit Profile'|trans, subtitle: 'Users'|trans}) }}
{% endblock main_header %}

