                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a class="fe fe-camera profile-edit text-primary" href="JavaScript:void(0);" data-bs-toggle="modal" data-bs-target="#profileEditModal"></a>
                                    {% endif %}
