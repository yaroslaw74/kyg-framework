                                            <img src="{{ gravatar(pageUser.gravatar) }}" alt="avatar">
                                        {% else %}
                                            {% if pageUser.avatar %}
                                                <img src="{{ asset('uploads/avatar/' ~ pageUser.avatar) }}" alt="avatar">
                                            {% else %}
                                                <img src="{{ asset('images/avatar/pngwing.com.png') }}" alt="avatar">
                                            {% endif %}
                                        {% endif %}
                                    {% else %}
                                        {% if pageUser.avatar %}
                                            <img src="{{ asset('uploads/avatar/' ~ pageUser.avatar) }}" alt="avatar">
                                        {% else %}
                                            <img src="{{ asset('images/avatar/pngwing.com.png') }}" alt="avatar">
