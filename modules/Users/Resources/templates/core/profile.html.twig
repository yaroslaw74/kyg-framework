                                {% set value_lastName = '' %}
                                {% set value_firstName = '' %}
                                {% set value_middleName = '' %}
                                {% set value_email = '' %}
                            {% endif %}
                            {{ form_start(profileForm, {action: path('app_user_show', {id: value_id})}) }}
                                {{ form_row(profileForm.username, {attr: {value: value_username}}) }}
                                {% if settings_instance('name').getFirstLastName %}
                                    {{ form_row(profileForm.lastName, {attr: {value: value_lastName}}) }}
                                    {{ form_row(profileForm.firstName, {attr: {value: value_firstName}}) }}
                                    {% if settings_instance('name').getMiddleNameEnable %}
                                        {{ form_row(profileForm.middleName, {attr: {value: value_middleName}}) }}
                                    {% endif %}
                                {% else %}
                                    {{ form_row(profileForm.firstName, {attr: {value: value_firstName}}) }}
                                    {% if settings_instance('name').getMiddleNameEnable %}
                                        {{ form_row(profileForm.middleName, {attr: {value:value_middleName}}) }}
                                    {% endif %}
                                    {{ form_row(profileForm.lastName, {attr: {value: value_lastName}}) }}
                                {% endif %}
                                {{ form_row(profileForm.email, {attr: {value: value_email}}) }}
                                {{ form_row(profileForm.plainPassword) }}
