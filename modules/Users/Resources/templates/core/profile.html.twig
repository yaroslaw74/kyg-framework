{% extends '@Core/empty.html.twig' %}

{% trans_default_domain 'users' %}

{% form_theme setAvatarUserForm 'bootstrap_5_layout.html.twig' %}

{% form_theme profileForm 'bootstrap_5_layout.html.twig' %}

{% if user %}
    {% set pageUser = user %}
{% else %}
    {% set pageUser = app.user %}
{% endif %}

{% block stylesheets %}
    {{ parent() }}
    <!-- GLightbox CSS -->
    <link rel="stylesheet" href="{{ asset('libs/glightbox/css/glightbox.min.css') }}">
{% endblock stylesheets %}

{% block main_header %}
    {{ include('@Core/partials/page-header.html.twig', {title: 'Profile'|trans, subtitle: 'Users'|trans}) }}
{% endblock main_header %}

