                                                                        <img src="{{ asset('uploads/avatar/' ~ friend.avatar) }}" alt="avatar" class="rounded-circle">
                                                                    {% else %}
                                                                        <img src="{{ asset('images/avatar/pngwing.com.png') }}" alt="avatar" class="rounded-circle">
                                                                    {% endif %}
                                                                {% endif %}
