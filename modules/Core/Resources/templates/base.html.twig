{% extends 'base.html.twig' %}

{% block html_attributes %}
    lang="{{ locale_HTML(app.locale) }}"
    dir="{{ locale_dir(app.locale) }}"
    data-nav-layout="vertical"
    data-bs-theme="light"
    data-theme-mode="light"
    data-header-styles="light"
    data-menu-styles="light"
    data-toggled="close"
{% endblock html_attributes %}

{% block meta %}
    <meta name="robots" content="noindex, nofollow">
    <meta name="autor" content="Kataev Yaroslav">
    <meta name="Description" content="KYG Framework for Business">
    <meta name="theme-color" content="#526cf7">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="HandheldFriendly" content="True">
    <meta name="MobileOptimized" content="320">
    {{ pwa() }}
{% endblock meta %}

{% block title %}
    {% if app_name %}
        {{ app_name }}|
    {% endif %}
    KYG Framework
{% endblock title %}

{% block importmap %}
    {{ importmap([locale_dir(app.locale), 'icons', 'valex-plugins', 'valex', 'app']) }}
{% endblock importmap %}

{% block body_attributes %}
    {{ stimulus_controller('swup', {
            theme: 'fade',
            debug: app.debug,
    }) }}
{% endblock body_attributes %}
